# Public (bundled into the browser — never put secrets here)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ANALYTICS_ID=
# Optional. Every apps/api request needs a resolvable tenant; real per-visitor tenant
# resolution is an open product decision (see docs/implementation/blockers.md) — until
# then, one configured tenant id per deployment. Matches a seeded Tenant.id, e.g. the
# dev seed's default tenant.
NEXT_PUBLIC_TENANT_ID=

# Server-only (never exposed to the browser)
API_INTERNAL_URL=http://localhost:4000
SESSION_COOKIE_NAME=antrique_session
SENTRY_DSN=
