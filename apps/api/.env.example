# Variables marked (validated) below are checked at startup by
# apps/api/src/config/env.validation.ts — an invalid or missing value
# aborts the app before it starts listening. Everything else in this file
# belongs to a config domain that's still a placeholder
# (apps/api/src/config/*/README.md) — nothing reads or validates it yet.
# See docs/architecture/validation.md.

# Runtime (validated)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
LOG_FORMAT=json

# Security / rate limiting (validated)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Database (validated — DATABASE_URL/DATABASE_SSL; PostgreSQL, RLS multi-tenancy)
# Matches docker-compose.yml's postgres service (POSTGRES_USER/PASSWORD/DB=antrique).
# This is the migration/owner connection (DDL rights, bypasses RLS as table owner) —
# fine for local dev where one role does everything. In production, DATABASE_URL
# should point to the least-privileged app role (see docs/architecture/database-schema.md
# "RLS strategy" — antrique_app/antrique_service must NOT be the table owner).
DATABASE_URL=postgresql://antrique:antrique@localhost:5432/antrique
# Only needed for `prisma migrate dev` (creates/drops a throwaway shadow DB to
# compute diffs). Not needed for `migrate deploy` (CI/production). Omit if the
# DATABASE_URL role already has CREATEDB (e.g. local dev superuser) — Prisma will
# then manage the shadow DB automatically.
# DATABASE_SHADOW_URL=postgresql://antrique:antrique@localhost:5432/antrique_shadow
DATABASE_SSL=false

# Redis (validated — cache/ and queue/ config domains both read this)
REDIS_URL=redis://localhost:6379

# Auth — managed IdP/OIDC (still unvalidated placeholders)
IDP_ISSUER_URL=https://your-idp.example.com
IDP_CLIENT_ID=replace-me
IDP_CLIENT_SECRET=replace-me

# JWT infrastructure (validated — Phase 1.2D.6; see apps/api/src/jwt/README.md).
# Secrets must be at least 32 characters — generate a real one for anything
# beyond local dev, e.g. `openssl rand -base64 48`. Access/refresh use
# different secrets so a compromised access token can't forge a refresh token.
JWT_ACCESS_SECRET=replace-me-with-a-real-random-secret-32-chars-min
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_SECRET=replace-me-with-a-different-real-random-secret-32-chars-min
JWT_REFRESH_TOKEN_TTL=2592000

# Argon2id hash tuning (validated — Phase 1.2D.7; see apps/api/src/password/README.md).
# Defaults are the OWASP-recommended Argon2id minimums. The algorithm variant
# itself (argon2id) is NOT configurable here — only these cost parameters.
HASH_MEMORY_COST=19456
HASH_TIME_COST=2
HASH_PARALLELISM=1

# Default tenant (validated — Milestone 1; see apps/api/src/modules/auth/README.md).
# A stopgap for real multi-tenant resolution (no subdomain/header-based
# tenant switching exists yet) — every login query is scoped to this one
# fixed tenant. Matches prisma/seed.ts's fixed TENANT_ID ("antrique" tenant);
# change this if you seed a different tenant ID.
DEFAULT_TENANT_ID=00000000-0000-7000-8000-000000000001

# Payments (hosted gateway only — this app never stores card data)
PAYMENT_GATEWAY_PUBLIC_KEY=replace-me
PAYMENT_GATEWAY_SECRET_KEY=replace-me
PAYMENT_WEBHOOK_SECRET=replace-me

# Object storage (pre-signed uploads)
STORAGE_BUCKET=antrique-assets
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me

# Transactional email (ESP)
EMAIL_PROVIDER_API_KEY=replace-me
EMAIL_FROM_ADDRESS=no-reply@antrique.dev

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# CORS (validated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# API tooling (validated) — Swagger UI (apps/api/src/main.ts) and the
# health controller (apps/api/src/health/) are both real as of Milestone 14.
# SWAGGER_ENABLED defaults true for local dev convenience; in production it
# must be false unless SWAGGER_ALLOW_IN_PRODUCTION=true is ALSO set — a
# deliberate second opt-in, not a copied-over dev default (see
# docs/architecture/security.md and env.validation.ts's own production-
# safety checks).
SWAGGER_ENABLED=true
SWAGGER_ALLOW_IN_PRODUCTION=false
SWAGGER_PATH=/api/docs
HEALTH_PATH=/health

# Runtime metadata (validated — Milestone 14; see apps/api/src/config/app/
# app.config.ts, consumed by the admin-only GET /admin/runtime endpoint).
# Stamped by CI/the Docker build (infrastructure/docker/api.Dockerfile's
# APP_VERSION/GIT_COMMIT_SHA build args) — never introspected from
# package.json at runtime. Safe, obviously-placeholder defaults for local
# dev, where the exact running version is never a real question.
APP_VERSION=0.0.0-dev
GIT_COMMIT_SHA=unknown
