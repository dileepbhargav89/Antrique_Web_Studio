# Variables marked (validated) below are checked at startup by
# apps/api/src/config/env.validation.ts — an invalid or missing value
# aborts the app before it starts listening. Everything else in this file
# belongs to a config domain that's still a placeholder
# (apps/api/src/config/*/README.md) — nothing reads or validates it yet.
# See docs/architecture/validation.md.

# Runtime (validated)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
LOG_FORMAT=json

# Security / rate limiting (validated)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Database (validated — DATABASE_URL/DATABASE_SSL; PostgreSQL, RLS multi-tenancy)
# Matches docker-compose.yml's postgres service (POSTGRES_USER/PASSWORD/DB=antrique).
# This is the migration/owner connection (DDL rights, bypasses RLS as table owner) —
# fine for local dev where one role does everything. In production, DATABASE_URL
# should point to the least-privileged app role (see docs/architecture/database-schema.md
# "RLS strategy" — antrique_app/antrique_service must NOT be the table owner).
DATABASE_URL=postgresql://antrique:antrique@localhost:5432/antrique
# Only needed for `prisma migrate dev` (creates/drops a throwaway shadow DB to
# compute diffs). Not needed for `migrate deploy` (CI/production). Omit if the
# DATABASE_URL role already has CREATEDB (e.g. local dev superuser) — Prisma will
# then manage the shadow DB automatically.
# DATABASE_SHADOW_URL=postgresql://antrique:antrique@localhost:5432/antrique_shadow
DATABASE_SSL=false

# Redis (validated — cache/ and queue/ config domains both read this)
REDIS_URL=redis://localhost:6379

# Auth (managed IdP, OIDC)
IDP_ISSUER_URL=https://your-idp.example.com
IDP_CLIENT_ID=replace-me
IDP_CLIENT_SECRET=replace-me
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# Payments (hosted gateway only — this app never stores card data)
PAYMENT_GATEWAY_PUBLIC_KEY=replace-me
PAYMENT_GATEWAY_SECRET_KEY=replace-me
PAYMENT_WEBHOOK_SECRET=replace-me

# Object storage (pre-signed uploads)
STORAGE_BUCKET=antrique-assets
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me

# Transactional email (ESP)
EMAIL_PROVIDER_API_KEY=replace-me
EMAIL_FROM_ADDRESS=no-reply@antrique.dev

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# CORS (validated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# API tooling (validated) — config only; no Swagger UI or health-check
# controller is wired up yet (Phase 1.2B+)
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
HEALTH_PATH=/health
