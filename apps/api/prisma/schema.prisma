// Antrique Web Studio — Prisma schema (Phase 1.1A: architecture only)
//
// Scope of this file: models, relationships, enums, indexes, constraints.
// NOT in scope (see docs/architecture/database-schema.md for the full list of
// deferred items): migrations, seed data, a wired-up PrismaClient, RLS policy
// SQL, partial/filtered unique indexes, and CHECK constraints — Prisma's
// schema DSL cannot express the last three; they land as raw SQL in the first
// migration (Phase 1.1B).
//
// Conventions (applied uniformly — see database-schema.md "Design rationale"
// for the reasoning behind each):
//   - id            String  @id @default(uuid(7)) @db.Uuid  — client-generated UUIDv7
//     (time-ordered, not v4/random — keeps B-tree PK indexes append-mostly
//     instead of randomly fragmenting on every insert; matters most on the
//     high-write tables: audit_logs, activity_logs, notifications, payments)
//   - tenant_id      on every table except `permissions` (the one global, non
//     tenant-scoped catalog) — the multi-tenancy spine, always indexed first.
//   - Audit block:  created_at, updated_at, created_by, updated_by, version
//     — on every general business entity. created_by/updated_by are bare
//     uuid columns with NO Prisma relation (avoids a dozen+ redundant
//     back-relations on User for what is metadata, not a business
//     relationship); version is an application-managed optimistic-lock
//     counter (Prisma does not auto-increment it).
//   - Soft delete:  deleted_at, deleted_by — on every general business
//     entity EXCEPT audit_logs, activity_logs, and payments (append-only per
//     docs/architecture/database.md) and pure join tables (hard-delete).
//   - Status is always a constrained enum, never a boolean, EXCEPT genuinely
//     binary flags (is_verified, is_system) called out explicitly in the
//     product docs as flags rather than lifecycles.
//   - snake_case in the database (CONTRIBUTING.md §1), camelCase in Prisma —
//     bridged with @map / @@map throughout.
//   - Referential actions (onDelete, on every FK — Phase 1.1A review addition):
//     Restrict on every relation to Tenant (never let an FK cascade a tenant
//     hard-delete) and on every other required relation to a real business
//     parent (forces the app-layer soft-delete pattern instead of orphaning
//     rows on a hard delete); SetNull on optional (nullable) FKs, generalizing
//     database.md's explicit "lead→project set-null"; Cascade only for rows
//     with zero standalone meaning once their one owner is gone — pure
//     join-table rows (UserRole, RolePermission, ProjectMember), Session (an
//     ephemeral auth artifact, not a business record), and quote/invoice line
//     items. See database-schema.md §3 for the full per-relation table.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// TENANCY & ACCESS CONTROL
// =============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CHURNED
}

/// The multi-tenancy isolation boundary. Every other table (except
/// `permissions`) carries a tenant_id back to this table; RLS policies
/// (Phase 1.1B) key off it exclusively.
model Tenant {
  id     String       @id @default(uuid(7)) @db.Uuid
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  users           User[]
  roles           Role[]
  sessions        Session[]
  clients         Client[]
  leads           Lead[]
  contactRequests ContactRequest[]
  projects        Project[]
  projectMembers  ProjectMember[]
  milestones      Milestone[]
  tasks           Task[]
  documents       Document[]
  quotations      Quotation[]
  quotationItems  QuotationItem[]
  invoices        Invoice[]
  invoiceItems    InvoiceItem[]
  payments        Payment[]
  media           Media[]
  blogs           Blog[]
  testimonials    Testimonial[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  auditLogs       AuditLog[]
  settings        Setting[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  categories      Category[]
  collections     Collection[]
  products        Product[]
  productVariants ProductVariant[]
  productImages   ProductImage[]

  // Milestone 6 (Bespoke Customizer Engine)
  fabricCategories             FabricCategory[]
  fabrics                      Fabric[]
  fabricImages                 FabricImage[]
  productFabrics               ProductFabric[]
  measurementProfiles          MeasurementProfile[]
  measurements                 Measurement[]
  styleOptionGroups            StyleOptionGroup[]
  styleOptions                 StyleOption[]
  styleOptionIncompatibilities StyleOptionIncompatibility[]
  productCustomizations        ProductCustomization[]
  pricingAdjustments           PricingAdjustment[]
  monogramOptions              MonogramOption[]

  // Milestone 7 (Inventory & Stock Management)
  warehouses            Warehouse[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  inventoryReservations InventoryReservation[]
  suppliers             Supplier[]
  supplierProducts      SupplierProduct[]

  // Milestone 8 (Order Management & Checkout)
  customers            Customer[]
  customerAddresses    CustomerAddress[]
  orders               Order[]
  orderItems           OrderItem[]
  orderStatusHistories OrderStatusHistory[]
  paymentRecords       PaymentRecord[]

  // Milestone 9 (CRM & Customer Operations)
  leadSources            LeadSource[]
  customerNotes          CustomerNote[]
  customerActivities     CustomerActivity[]
  followUpTasks          FollowUpTask[]
  customerTags           CustomerTag[]
  customerTagAssignments CustomerTagAssignment[]

  // Milestone 10 (Payments & Billing Foundation)
  taxRates           TaxRate[]
  paymentMethods     PaymentMethod[]
  paymentAllocations PaymentAllocation[]

  // Milestone 11 (Admin Platform, Analytics & Notifications)
  notificationTemplates NotificationTemplate[]
  systemEvents          SystemEvent[]
  dashboardWidgets      DashboardWidget[]
  scheduledReports      ScheduledReport[]

  // Phase 7 (Real Email — Newsletter)
  newsletterSubscribers NewsletterSubscriber[]

  // Phase 7 (Project/Task/Milestone)
  comments Comment[]

  // Phase 8 (AI Workspace)
  promptTemplates PromptTemplate[]
  contentDrafts   ContentDraft[]

  // Phase 9 (Enterprise Operations Suite, Module 1: Finance)
  vendors Vendor[]

  @@map("tenants")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Portal + admin accounts. `client_id` is null for internal Antrique staff
/// and set for a Client-side portal user. Two independent, optional
/// credential paths, per docs/architecture/security.md's "managed IdP OR
/// local email+password" (Milestone 1 — password auth added alongside the
/// original IdP-only design, not replacing it): `idp_subject` links to an
/// external managed-IdP identity (SSO/SAML), `password_hash` is a local
/// Argon2id hash verified via `PasswordService`. Both are nullable — a
/// user may have either, and a user provisioned via one path doesn't need
/// the other populated. Neither is validated as "at least one must be set"
/// at the schema level (Prisma/Postgres can't express a cross-column CHECK
/// requiring OR-presence cleanly here); that's an application-layer
/// concern for whichever future phase builds user provisioning/invites.
model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  clientId            String?    @map("client_id") @db.Uuid
  idpSubject          String?    @unique @map("idp_subject")
  passwordHash        String?    @map("password_hash")
  email               String
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  status              UserStatus @default(INVITED)
  // Phase 10, Module 4 (Authentication & Session Security) — account
  // lockout policy, independent of the IP-based `@Throttle()` on
  // `POST /auth/login` (Module 3): this catches a distributed/low-and-
  // slow attack against ONE account from many IPs, which IP throttling
  // alone can't. Reset to 0 on any successful login; `lockedUntil` set
  // once `failedLoginAttempts` crosses `MAX_FAILED_LOGIN_ATTEMPTS`
  // (auth.constant.ts).
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  userRoles               UserRole[]
  sessions                Session[]
  projectMemberships      ProjectMember[]
  assignedTasks           Task[]               @relation("TaskAssignee")
  uploadedDocuments       Document[]           @relation("DocumentUploadedBy")
  uploadedMedia           Media[]              @relation("MediaUploadedBy")
  authoredBlogs           Blog[]               @relation("BlogAuthor")
  assignedLeads           Lead[]               @relation("LeadAssignee")
  preparedQuotations      Quotation[]          @relation("QuotationPreparedBy")
  notifications           Notification[]
  activityLogEntries      ActivityLog[]        @relation("ActivityLogActor")
  auditLogEntries         AuditLog[]           @relation("AuditLogActor")
  // Phase 7 (Project/Task/Milestone) — the staff user who wrote a Comment
  // on a Task or Milestone (nullable — same "actor may be unknown/system-
  // generated" allowance every other author-ish field in this schema
  // already has).
  authoredComments        Comment[]            @relation("CommentAuthor")
  // Milestone 6 — the portal user a MeasurementProfile's body measurements
  // belong to (not asked for explicitly by this milestone's own
  // "Relationships" list, but a measurement profile needs SOME owner to
  // be meaningful — see MeasurementProfile's own doc comment).
  measurementProfiles     MeasurementProfile[]
  // Milestone 8 — the portal user a Customer record belongs to, same
  // "not explicitly asked for, but needed for the entity to be
  // meaningful" reasoning as MeasurementProfile.userId above.
  customers               Customer[]
  // Milestone 9 — the staff user who authored a CustomerNote / performed
  // a CustomerActivity / is assigned a FollowUpTask (all nullable — same
  // "actor may be unknown/system-generated" allowance ActivityLog.actor
  // already established).
  authoredCustomerNotes   CustomerNote[]       @relation("CustomerNoteAuthor")
  customerActivityEntries CustomerActivity[]   @relation("CustomerActivityActor")
  assignedFollowUpTasks   FollowUpTask[]       @relation("FollowUpTaskAssignee")
  // Milestone 11 — the staff user who triggered a report generation
  // (nullable — a report may be system-generated, same allowance every
  // other actor-ish field in this schema already has).
  generatedReports        ScheduledReport[]

  // NOTE (Phase 1.1B): replace with a PARTIAL unique index —
  //   CREATE UNIQUE INDEX ON users (tenant_id, email) WHERE deleted_at IS NULL;
  // — Prisma's schema DSL cannot express filtered indexes; this @@unique is a
  // stand-in so the constraint isn't silently missing, but it will incorrectly
  // block email reuse after a soft-deleted user. See database-schema.md.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([clientId])
  @@map("users")
}

/// Per-tenant role. `is_system` marks the seeded default roles (Admin, PM,
/// etc. — seeded in the RBAC-model task, not here) as non-editable/non-
/// deletable by tenant admins.
model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  // NOTE (Phase 1.1B): partial unique WHERE deleted_at IS NULL — see User note above.
  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

/// Global permission catalog (`resource:action`), NOT tenant-scoped — every
/// tenant's roles draw from the same shared catalog. Seeded via migration,
/// not user-editable (no update path in the API contract).
model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}

/// user ↔ role. Pure join table — hard-delete, no soft-delete/version
/// (docs/architecture/database.md "join tables hard-delete").
model UserRole {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_roles")
}

/// role ↔ permission. Pure join table — hard-delete, no soft-delete/version.
model RolePermission {
  tenantId     String @map("tenant_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// This app's own refresh-token session, issued after the managed-IdP
/// exchange (see security.md "short sessions... rotating refresh, reuse
/// detection"). `replaced_by_session_id` chains rotations: presenting a
/// token whose session is already revoked-and-replaced is a reuse/theft
/// signal the app layer checks against.
model Session {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @unique @map("refresh_token_hash")
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  issuedAt            DateTime  @default(now()) @map("issued_at")
  expiresAt           DateTime  @map("expires_at")
  lastUsedAt          DateTime? @map("last_used_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at")
  version             Int       @default(1)

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBySession Session?  @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  rotatedFrom       Session[] @relation("SessionRotation")

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
  @@index([replacedBySessionId])
  @@map("sessions")
}

// =============================================================================
// CRM
// =============================================================================

enum ContactRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  SPAM
  CLOSED
}

/// Unqualified inbound inbox (public contact form) — lighter-weight than a
/// Lead; converts into one via `converted_lead_id`. `company` added Phase 7
/// (Real Email/Contact) — the frontend contact form already collected it;
/// this model had zero application-layer consumers before Phase 7, so
/// adding one nullable column is a safe, purely additive completion, not
/// a change to an existing contract.
model ContactRequest {
  id              String               @id @default(uuid(7)) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  name            String
  email           String
  phone           String?
  company         String?
  message         String
  source          String?
  status          ContactRequestStatus @default(NEW)
  convertedLeadId String?              @map("converted_lead_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  convertedLead Lead?  @relation(fields: [convertedLeadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([convertedLeadId])
  @@map("contact_requests")
}

enum NewsletterSubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

/// Marketing-site newsletter signup (Phase 7 — Real Email) — distinct from
/// ContactRequest (a message-based inbound inquiry): no message, just an
/// ongoing subscription state. Uniqueness per tenant+email is enforced at
/// the application layer (find-then-create/update in
/// NewsletterSubscriberRepository, the same "partial unique index can't be
/// expressed in the Prisma DSL" find-then-act pattern this schema's own
/// Role/User/Setting models already use), not a schema-level `@@unique` —
/// a hard unique constraint would permanently block a legitimate
/// re-subscribe after a soft-deleted unsubscribe. A real DB-level partial
/// unique index (raw SQL, matching the 20260717091500_row_level_security
/// migration's own precedent) is a reasonable future hardening pass, not
/// built this phase.
model NewsletterSubscriber {
  id             String                     @id @default(uuid(7)) @db.Uuid
  tenantId       String                     @map("tenant_id") @db.Uuid
  email          String
  status         NewsletterSubscriberStatus @default(SUBSCRIBED)
  subscribedAt   DateTime                   @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime?                  @map("unsubscribed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, status])
  @@map("newsletter_subscribers")
}

enum LeadStatus {
  NEW
  QUALIFIED
  QUOTED
  CONVERTED
  LOST
  // Milestone 9 — "Archive" is its own controller action, distinct from
  // soft-delete: an archived lead stays visible/queryable (soft-delete
  // means "hidden from active views entirely"), it's just frozen —
  // "Archived leads immutable," this milestone's own explicit business
  // rule, enforced in LeadService.update()/convert() by rejecting any
  // mutation once status is ARCHIVED (or CONVERTED — also terminal).
  ARCHIVED
}

/// CRM pipeline record. Field shape matches the authoritative OpenAPI `Lead`
/// schema (packages/api-contract/openapi/openapi.yaml) exactly.
///
/// Milestone 9 (CRM & Customer Operations) reuses this model wholesale —
/// architecture audit found it already fully schema'd (Phase 1.1A) with
/// zero application-layer consumers (no LeadRepository/LeadService/
/// LeadController existed before this milestone), the same "schema
/// exists, first real consumer" situation Milestone 3 found for Role/
/// Permission. `leadSourceId`/`convertedCustomerId` are the only two
/// fields this milestone adds, both nullable and purely additive:
/// - `convertedCustomerId` → `Customer` (Milestone 8's e-commerce
///   customer) is a NEW, SEPARATE conversion target from the existing
///   `convertedClientId` → `Client` (the agency's own B2B service
///   customer) — this milestone's own explicit "Convert Lead → Customer"
///   business rule and "Use: CustomerRepository" integration requirement
///   point at `Customer`, not `Client`. The two conversion paths are
///   deliberately independent, mirroring `Customer`'s own schema comment
///   ("distinct from Client... the two are unrelated on purpose") — a
///   lead converted through the CRM module's own `LeadService.convert()`
///   sets `convertedCustomerId`+`status=CONVERTED`; `convertedClientId`
///   is untouched by this milestone, still set only by whatever future
///   flow the original agency-CRM design anticipated. See
///   docs/implementation/decisions.md.
/// - `leadSourceId` → `LeadSource` (new lookup table this milestone
///   adds) is additive alongside the existing free-text `source` column,
///   not a replacement — see `LeadSource`'s own comment for why.
model Lead {
  id                  String     @id @default(uuid(7)) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  contactName         String     @map("contact_name")
  contactEmail        String     @map("contact_email")
  organization        String?
  source              String
  leadSourceId        String?    @map("lead_source_id") @db.Uuid
  serviceInterest     String[]   @map("service_interest")
  industry            String?
  status              LeadStatus @default(NEW)
  assigneeId          String?    @map("assignee_id") @db.Uuid
  convertedClientId   String?    @map("converted_client_id") @db.Uuid
  convertedCustomerId String?    @map("converted_customer_id") @db.Uuid
  metadata            Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignee          User?              @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  convertedClient   Client?            @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedCustomer Customer?          @relation(fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  leadSource        LeadSource?        @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  contactRequests   ContactRequest[]
  projects          Project[]
  quotations        Quotation[]
  activities        CustomerActivity[]
  followUpTasks     FollowUpTask[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([assigneeId])
  @@index([convertedClientId])
  @@index([convertedCustomerId])
  @@index([leadSourceId])
  @@map("leads")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// The agency's customer organization — what a converted Lead becomes, and
/// what Projects/Quotations/Invoices/Testimonials attach to. Distinct from
/// `Tenant`: Tenant is the platform's isolation boundary (one Antrique
/// instance); Client is one of *that tenant's own* customers.
model Client {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  name         String
  industry     String?
  website      String?
  primaryEmail String?      @map("primary_email")
  primaryPhone String?      @map("primary_phone")
  status       ClientStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users        User[]
  leadsWon     Lead[]
  projects     Project[]
  quotations   Quotation[]
  invoices     Invoice[]
  testimonials Testimonial[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("clients")
}

// =============================================================================
// DELIVERY
// =============================================================================

enum ProjectStatus {
  DRAFT
  ACTIVE
  IN_REVIEW
  LAUNCHED
  MAINTENANCE
  ARCHIVED
}

/// Field shape matches the authoritative OpenAPI `Project` schema.
model Project {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  clientId  String        @map("client_id") @db.Uuid
  leadId    String?       @map("lead_id") @db.Uuid
  name      String
  summary   String?
  status    ProjectStatus @default(DRAFT)
  startDate DateTime?     @map("start_date") @db.Date
  metadata  Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead         Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  milestones   Milestone[]
  tasks        Task[]
  documents    Document[]
  invoices     Invoice[]
  activityLogs ActivityLog[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([clientId])
  @@index([leadId])
  @@map("projects")
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  CONTRIBUTOR
  VIEWER
}

/// project ↔ user, with the member's role on that specific project. Pure
/// join table — hard-delete (removing someone from a project doesn't need a
/// tombstone; their historical task/document rows keep their own audit trail).
model ProjectMember {
  tenantId  String            @map("tenant_id") @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      ProjectMemberRole @default(CONTRIBUTOR)
  addedAt   DateTime          @default(now()) @map("added_at")
  addedBy   String?           @map("added_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("project_members")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

/// Client-visible progress checkpoint. Status set matches the OpenAPI
/// `Milestone` schema plus CHANGES_REQUESTED (the client-portal review-loop
/// outcome described in docs/product's client-dashboard content, absent from
/// the v1 API enum — flagged for an OpenAPI update in Phase 1.1B/Sprint 4).
model Milestone {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?       @map("due_date") @db.Date
  completedAt DateTime?       @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tasks    Task[]
  comments Comment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([projectId])
  @@map("milestones")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Internal work-item granularity below Milestone. Not exposed in the v1
/// OpenAPI contract yet (internal delivery-team tool, not client-facing) —
/// add `/projects/{id}/tasks` when the delivery-console UI needs it.
model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  milestoneId String?      @map("milestone_id") @db.Uuid
  assigneeId  String?      @map("assignee_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date") @db.Date
  completedAt DateTime?    @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
