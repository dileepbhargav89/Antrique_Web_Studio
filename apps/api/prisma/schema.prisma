enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

/// Quote-wizard output. `lead_id`/`client_id` are both nullable but exactly
/// one should be set (a fresh prospect quote vs. a repeat-business quote for
/// an existing client) — enforced at the application layer; Prisma's schema
/// DSL has no cross-column CHECK support (see database-schema.md).
model Quotation {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  leadId          String?         @map("lead_id") @db.Uuid
  clientId        String?         @map("client_id") @db.Uuid
  preparedById    String?         @map("prepared_by_id") @db.Uuid
  quotationNumber String          @map("quotation_number")
  currency        String          @default("INR") @db.VarChar(3)
  subtotalAmount  Decimal         @map("subtotal_amount") @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(12, 2)
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?       @map("valid_until") @db.Date
  issuedAt        DateTime?       @map("issued_at")
  notes           String?
  /// Phase 7 (Enterprise CRM/Project-Management) — set when `POST
  /// /quotations/:id/send` generates and stores the PDF (DocumentPdfService
  /// + StorageService); null until then. Genuinely additive — nothing
  /// before this phase read or wrote this column.
  pdfUrl          String?         @map("pdf_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client     Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  preparedBy User?           @relation("QuotationPreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  items      QuotationItem[]
  invoices   Invoice[]

  // NOTE (Phase 1.1B): partial unique WHERE deleted_at IS NULL — see User note above.
  @@unique([tenantId, quotationNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([leadId])
  @@index([clientId])
  @@index([preparedById])
  @@map("quotations")
}

/// Line item, snapshotted at quote time (amount is stored, not recomputed
/// from a live price list — unit prices can change after the quote ships).
model QuotationItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  quotationId String  @map("quotation_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quotationId])
  @@map("quotation_items")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

/// Field shape matches the authoritative OpenAPI `Invoice` schema (plus
/// normalized line items and a lineage link back to the originating
/// Quotation — see database-schema.md for why line items were added beyond
/// the literal model list). `amountPaid` is a denormalized running total
/// maintained by the application whenever a `Payment` succeeds — added so
/// "partially paid" is representable without summing Payment rows on every
/// read; deliberately NOT a new InvoiceStatus value, since the status enum
/// mirrors the authoritative OpenAPI contract and shouldn't diverge from it
/// without a corresponding API change (see database-schema.md, Phase 1.1A review).
///
/// Milestone 10 (Payments & Billing Foundation) reuses this model wholesale
/// — architecture audit found it already fully schema'd (Phase 1.1A) with
/// zero application-layer consumers (no InvoiceRepository/InvoiceService/
/// InvoiceController existed before this milestone), the same "schema
/// exists, first real consumer" situation Milestone 9 found for `Lead`.
/// `customerId`/`orderId`/`taxRateId` are the only new fields, all
/// nullable and additive:
/// - `customerId` → `Customer` (Milestone 8's e-commerce customer) is a
///   NEW invoicing path — "Invoices belong to Orders," this milestone's
///   own explicit framing — kept deliberately SEPARATE from the
///   pre-existing `clientId` → `Client` (the agency's own B2B service-
///   billing path), the same "two independent conversion/attachment
///   paths on one shared entity" pattern Milestone 9 established for
///   `Lead.convertedCustomerId` vs. `convertedClientId`. `clientId`
///   changed from required to nullable so an order-based invoice can
///   omit it — the existing agency-billing flow (still uninstantiated,
///   zero consumers either way) is otherwise untouched.
/// - `orderId` → `Order` is this milestone's own "Create from Order"
///   entry point; only ever set alongside `customerId` (never with
///   `clientId` — see the hand-written CHECK constraints in the
///   migration).
/// - `taxRateId` → `TaxRate`, this milestone's own "Calculate tax
///   server-side" requirement — resolved once at creation time, the
///   resulting `taxAmount` stored (never recomputed live), the same
///   "compute once, store the result" discipline `OrderItem.lineTotal`
///   already established.
/// See docs/implementation/decisions.md for the full reasoning.
model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  clientId       String?       @map("client_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  orderId        String?       @map("order_id") @db.Uuid
  projectId      String?       @map("project_id") @db.Uuid
  quotationId    String?       @map("quotation_id") @db.Uuid
  taxRateId      String?       @map("tax_rate_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number")
  currency       String        @default("INR") @db.VarChar(3)
  subtotalAmount Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  issuedDate     DateTime?     @map("issued_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client      Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotation   Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  taxRate     TaxRate?            @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]
  allocations PaymentAllocation[]

  // NOTE (Phase 1.1B): partial unique WHERE deleted_at IS NULL — see User note above.
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, dueDate])
  @@index([clientId])
  @@index([customerId])
  @@index([orderId])
  @@index([projectId])
  @@index([quotationId])
  @@index([taxRateId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Append-only: one row per gateway webhook event, never updated in place
/// (docs/architecture/database.md — payment is exempt from soft-delete and
/// the audit/version mixin, same as audit_logs). The API never accepts card
/// data; this table only ever holds a hosted-gateway reference.
///
/// Milestone 10 (Payments & Billing Foundation) reuses this model wholesale
/// for its OWN, different-shaped flow: manually RECORDED payments (a staff
/// member logs "customer paid ₹500 by bank transfer"), not gateway webhook
/// events — this milestone's own explicit "Do NOT Implement: Stripe/
/// Razorpay/PayPal/UPI gateway/Webhooks" excludes the flow this model was
/// originally built for. Additive changes only, preserving the original
/// shape for whenever a real gateway integration milestone arrives:
/// - `invoiceId` is now NULLABLE — "Record payment" and "Allocate
///   payment" are separate business responsibilities (this milestone's
///   own explicit split): a payment can be recorded before it's
///   allocated to any specific invoice. `PaymentAllocation` (new) is
///   where the actual invoice-by-invoice breakdown lives, even for the
///   common single-invoice case — `PaymentService.record()` sets
///   `invoiceId` as a convenience/primary reference AND creates the
///   matching `PaymentAllocation` row atomically, when an invoice is
///   given at record time.
/// - `provider`/`providerRef` are now NULLABLE — a manually-recorded
///   payment has neither (no gateway involved); still required together
///   whenever a real gateway integration eventually populates them.
/// - `paymentMethodId` (→ new `PaymentMethod` lookup, nullable) +
///   `method` (required free-text fallback, mirrors `Lead.source`'s own
///   "always populated, optionally backed by a formal lookup row"
///   pattern from Milestone 9) describe how a MANUALLY recorded payment
///   was received (cash/bank transfer/cheque/...).
/// Still genuinely append-only — `payments` already has `UPDATE`/`DELETE`
/// revoked at the database-privilege level (`20260717091500_row_level_security`,
/// same treatment as `audit_logs`) — `PaymentService` only ever calls
/// `create()`, never `update()`. See docs/implementation/decisions.md.
model Payment {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  invoiceId       String?       @map("invoice_id") @db.Uuid
  paymentMethodId String?       @map("payment_method_id") @db.Uuid
  method          String
  reference       String?
  provider        String?
  providerRef     String?       @map("provider_ref")
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR") @db.VarChar(3)
  status          PaymentStatus

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice       Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  allocations   PaymentAllocation[]

  @@unique([tenantId, providerRef])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([invoiceId])
  @@index([paymentMethodId])
  @@map("payments")
}

