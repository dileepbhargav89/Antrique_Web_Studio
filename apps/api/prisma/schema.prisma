  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([projectId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@index([assigneeId, status])
  @@map("tasks")
}

enum DocumentStatus {
  UPLOADING
  READY
  QUARANTINED
  FAILED
}

/// Project-scoped file (handover docs, shared files). Field shape matches
/// the OpenAPI `Asset` schema — renamed `Document` here per this task's
/// model list; distinct from `Media` (CMS content images), which has an
/// independent lifecycle not tied to any project.
model Document {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  projectId    String         @map("project_id") @db.Uuid
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
