}

// =============================================================================
// PLATFORM (notifications, logging, settings)
// =============================================================================

enum NotificationChannel {
  IN_APP
  EMAIL
}

// Milestone 11 — "Notification status lifecycle"/"Failed notifications
// are retryable," this milestone's own explicit business rules. Did not
// exist before this milestone — the pre-existing `Notification` model
// only tracked RECIPIENT interaction (`readAt`/`dismissedAt`), nothing
// about DELIVERY state.
enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  FAILED
}

/// `type` is a free-form event key (e.g. "invoice.paid", "milestone.approved")
/// rather than an enum — new notification types are added constantly as
/// features ship, and an enum would need a schema migration for each one.
/// `related_resource_*` is an intentionally unenforced polymorphic reference
/// (Postgres has no native polymorphic FK); validated at the application
/// layer only.
///
/// Milestone 11 (Admin Platform, Analytics & Notifications) reuses this
/// model wholesale — architecture audit found it already fully schema'd
/// (Phase 1.1B) with zero application-layer consumers, the same "schema
/// exists, first real consumer" situation Milestones 3/9/10 already
/// found. `status`/`sentAt`/`failedAt`/`retryCount`/`lastError` are the
/// only new columns, all additive: the pre-existing `readAt`/
/// `dismissedAt` describe what the RECIPIENT did with a delivered
/// notification; these five describe DELIVERY itself — "Create → Queue →
/// Mark sent / Mark failed → Retry" (this milestone's own explicit
/// lifecycle), a genuinely separate concern neither overlaps with. See
/// docs/implementation/decisions.md.
model Notification {
  id                  String              @id @default(uuid(7)) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  type                String
  channel             NotificationChannel @default(IN_APP)
  title               String
  body                String?
  relatedResourceType String?             @map("related_resource_type")
  relatedResourceId   String?             @map("related_resource_id") @db.Uuid
  readAt              DateTime?           @map("read_at")
  dismissedAt         DateTime?           @map("dismissed_at")
  status              NotificationStatus  @default(PENDING)
  sentAt              DateTime?           @map("sent_at")
  failedAt            DateTime?           @map("failed_at")
  retryCount          Int                 @default(0) @map("retry_count")
  lastError           String?             @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([userId, readAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  // Phase 10, Module 1 (Performance) — NotificationListQueryDto filters
  // by userId AND status together (the "my unread notifications" case);
  // neither existing composite covers both.
  @@index([tenantId, userId, status])
  @@map("notifications")
}

/// Human-readable business timeline (the portal's "Timeline (event feed)"
/// and the admin activity dashboard) — NOT the compliance audit trail; see
/// `AuditLog` for that. Append-only, no soft-delete/version.
model ActivityLog {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  projectId   String? @map("project_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  verb        String
  summary     String
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor   User?    @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([projectId])
  @@index([actorUserId])
  @@map("activity_logs")
}

/// Immutable, write-once compliance/security trail. Field shape matches
/// docs/architecture/database.md exactly (actor, action, resource,
/// before/after, ip, ua, timestamp). Never updated, never soft-deleted.
///
/// Milestone 11 (Admin Platform, Analytics & Notifications) reuses this
/// model wholesale, unchanged — zero schema changes. Architecture audit
/// found it already exactly matching this milestone's own "AuditLog"
/// core entity and "Record security events"/"Record business events"/
/// "Immutable audit history" business rules, with zero application-layer
/// consumers (this is its first real repository/service/controller) —
/// AND already enforcing "Audit records are append-only" at the
/// database-privilege level (`UPDATE`/`DELETE` revoked,
/// `20260717091500_row_level_security`) before any application code
/// existed, the same situation Milestone 10 found for `payments`. See
/// docs/implementation/decisions.md.
model AuditLog {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  actorUserId  String? @map("actor_user_id") @db.Uuid
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id") @db.Uuid
  before       Json?
  after        Json?
  ipAddress    String? @map("ip_address")
  userAgent    String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Tenant-level configuration (feature flags, branding, preferences) — NEVER
/// secrets (those live in the vault/KMS per CLAUDE.md, not the database).
model Setting {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  key         String
  value       Json
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // NOTE (Phase 1.1B): partial unique WHERE deleted_at IS NULL — see User note above.
  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("settings")
}

// =============================================================================
// CATALOG (Milestone 5 — Product Catalog Foundation)
// =============================================================================
// No product-catalog guidance exists in docs/product/ as of this milestone
// (checked — those docs model Antrique purely as a web agency selling
// services to its own clients, no e-commerce/product concept anywhere);
// this section is a deliberately generic catalog design, not modeled on
// any specific product line. Flagged, not silently assumed — see
// docs/implementation/decisions.md, matching prisma/seed.ts's own
// "Scope gap, flagged rather than silently resolved" precedent (Phase 1.1B).

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

/// Flat (non-hierarchical) product grouping for navigation/browsing. No
/// parent/child nesting — not asked for by this milestone's brief, and
/// added only if a future milestone genuinely needs it.
model Category {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  // NOTE (Milestone 5, same landmine as User/Role/Quotation/Invoice/Blog/
  // Settings): replace with a PARTIAL unique index WHERE deleted_at IS
  // NULL in the hand-written migration — Prisma's schema DSL cannot
  // express filtered indexes. See database-schema.md.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("categories")
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
}

/// Curated product grouping (e.g. a seasonal or themed set), independent
/// of Category — a Product optionally belongs to one of each, not a
/// many-to-many join in either direction (this milestone's brief lists
/// "Category → Products"/"Collection → Products" as one-to-many
/// relationships, not a join table).
model Collection {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  status      CollectionStatus @default(ACTIVE)
  sortOrder   Int              @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  // NOTE (Milestone 5): partial unique WHERE deleted_at IS NULL — see
  // Category note above.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("collections")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// The catalog's core entity. `categoryId`/`collectionId` are both
/// optional — nothing in this milestone's brief requires every product to
/// have either. Base for the future Bespoke Customizer/ordering system
/// (out of scope here — see this milestone's "Do NOT Implement" list);
/// `metadata` is a deliberately open `Json?` escape hatch for whatever
/// customization/ordering-specific attributes a future phase needs,
/// without a schema migration for each one (the same reasoning
/// `Notification.type`/`Lead.metadata` already established elsewhere in
/// this schema).
model Product {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  categoryId   String?       @map("category_id") @db.Uuid
  collectionId String?       @map("collection_id") @db.Uuid
  name         String
  slug         String
  description  String?       @db.Text
  status       ProductStatus @default(DRAFT)
  sortOrder    Int           @default(0) @map("sort_order")
  metadata     Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collection Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  images     ProductImage[]

  // Milestone 6 (Bespoke Customizer Engine) — the forward reference this
  // model's own doc comment above named. `customization` is 1:1 (a
  // product has at most one bespoke configuration); `productFabrics` is
  // the many-to-many join to the reusable, tenant-wide Fabric catalog
  // (a join table, not named in this milestone's "Core entities" list,
  // but structurally required — see product_fabrics's own doc comment).
  customization  ProductCustomization?
  productFabrics ProductFabric[]

  // NOTE (Milestone 5): partial unique WHERE deleted_at IS NULL — see
  // Category note above.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([categoryId])
  @@index([collectionId])
  @@map("products")
}

/// Purchasable SKU-level unit of a Product (e.g. a specific size/material/
/// color combination). Line-item shaped like `QuotationItem`/`InvoiceItem`
/// — `createdAt`/`updatedAt` only, no soft-delete/version, Cascade-deleted
/// with its parent Product — not a standalone-manageable entity: this
/// milestone's brief lists no ProductVariant repository/controller, only
/// Category/Collection/Product get their own REST surface, so variants
/// are always read/written as part of their Product. `price` is a plain
/// stored `Decimal` — no computation, no rules, no currency conversion;
/// "pricing engine" is explicitly out of this milestone's scope, and this
/// is data, not logic, the same distinction `Quotation`/`Invoice`'s
/// stored amounts already draw. `attributes` is an open `Json?` bag for
/// whatever variant-defining traits a future Bespoke Customizer needs
/// (size, material, color, ...) without a schema migration per trait.
model ProductVariant {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  sku        String
  name       String?
  attributes Json?
  price      Decimal @db.Decimal(12, 2)
  isActive   Boolean @default(true) @map("is_active")
  sortOrder  Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Milestone 7 (Inventory & Stock Management)
  inventoryItems   InventoryItem[]
  supplierProducts SupplierProduct[]

  // Milestone 8 (Order Management & Checkout)
  orderItems OrderItem[]

  // No soft-delete on this table, so — unlike Category/Collection/Product
  // above — this @@unique needs no partial-index treatment; a real
  // (non-Prisma-DSL-limited) plain unique index is correct as generated.
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

/// Product image reference — a URL + alt text only. No upload mechanism,
/// no CDN integration, no storage-key/file-size tracking like
/// `Document`/`Media` have (both explicitly out of this milestone's
/// scope) — a future phase that adds real upload handling can extend
/// this model then. Same line-item shape as `ProductVariant`.
model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("product_images")
}

// =============================================================================
// BESPOKE CUSTOMIZER (Milestone 6 — Bespoke Customizer Engine)
// =============================================================================
// Same "no domain guidance exists" situation Milestone 5 flagged for the
// catalog: docs/product/*.md has zero mention of "Bespoke Customizer"
// beyond this codebase's own forward-reference comments on
// Product/ProductVariant above (checked fresh for this milestone, not
// assumed) — this section is a deliberately generic bespoke-garment
// design, not modeled on any specific brand's real customization flow.
//
// Structural note on entity naming vs. this milestone's own brief: the
// brief's "Repository Layer"/"Controllers" sections name a
// "MeasurementRepository" + "Measurement Profiles" controller (repository
// named after the child `Measurement`, controller named after the parent
// `MeasurementProfile`) and a "StyleOptionRepository" + "Style Options"
// controller (both named after `StyleOption`, not `StyleOptionGroup`).
// Read literally and consistently: MeasurementProfile is the aggregate
// root written through a class literally named `MeasurementRepository`
// (nested Measurement children, no independent Measurement CRUD — same
// shape as ProductRepository/ProductVariant in Milestone 5), while
// StyleOption gets its own full standalone CRUD surface referencing an
// existing `styleOptionGroupId` (StyleOptionGroup itself has no
// controller — it's created only as nested data under
// ProductCustomization, like StyleOptionGroup's own doc comment below
// explains). This asymmetry is intentional, not an oversight — see
// docs/implementation/decisions.md.

enum FabricCategoryStatus {
  ACTIVE
  ARCHIVED
}

/// Simple lookup/grouping for fabrics (e.g. "Wool", "Cotton", "Silk") — no
/// controller of its own (not listed under this milestone's "Controllers"
/// section, unlike Category in Milestone 5), managed via prisma/seed.ts
/// for now; still a real, tenant-scoped, soft-deletable table so a future
/// milestone can add CRUD without a schema change. Referenced by Fabric's
/// optional `fabricCategoryId` and by this milestone's own "Filtering:
/// Fabric category" requirement.
model FabricCategory {
  id          String               @id @default(uuid(7)) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  status      FabricCategoryStatus @default(ACTIVE)
  sortOrder   Int                  @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fabrics Fabric[]

  // NOTE (Milestone 6, same landmine as every soft-deletable tenant-scoped
  // unique key before it): replace with a PARTIAL unique index WHERE
  // deleted_at IS NULL in the hand-written migration.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("fabric_categories")
}

enum FabricStatus {
  ACTIVE
  ARCHIVED
}

/// The reusable, tenant-wide fabric catalog a customizable Product draws
/// from via the `ProductFabric` join (many-to-many — a fabric like "Navy
/// Wool Twill" can be offered across many products, and a product
/// typically offers several fabric choices). `priceAdjustment` is a
/// plain stored `Decimal` delta added to the base price for choosing this
/// fabric — same "data, not a pricing engine" discipline
/// `ProductVariant.price` already established in Milestone 5; it may be
/// negative (a cheaper fabric could reasonably discount the base price).
model Fabric {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  fabricCategoryId String?      @map("fabric_category_id") @db.Uuid
  name             String
  slug             String
  description      String?
  composition      String?
  colorHex         String?      @map("color_hex")
  priceAdjustment  Decimal      @default(0) @map("price_adjustment") @db.Decimal(12, 2)
  status           FabricStatus @default(ACTIVE)
  sortOrder        Int          @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fabricCategory FabricCategory? @relation(fields: [fabricCategoryId], references: [id], onDelete: SetNull)
  images         FabricImage[]
  productFabrics ProductFabric[]

  // Milestone 7 (Inventory & Stock Management)
  inventoryItems   InventoryItem[]
  supplierProducts SupplierProduct[]

  // NOTE (Milestone 6): partial unique WHERE deleted_at IS NULL — see
  // FabricCategory note above.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([fabricCategoryId])
  @@map("fabrics")
}

/// Fabric swatch image — same line-item shape as `ProductImage`
/// (Milestone 5): `createdAt`/`updatedAt` only, no soft-delete/version,
/// Cascade-deleted with its parent Fabric, no standalone controller (only
/// "Fabrics" is listed under this milestone's "Controllers" section).
model FabricImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  fabricId  String  @map("fabric_id") @db.Uuid
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fabric Fabric @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fabricId])
  @@map("fabric_images")
}

/// Product ↔ Fabric many-to-many join — not named in this milestone's
/// "Core entities" list, but structurally required to express "Product →
/// Fabrics" as anything other than one-fabric-per-product (which would
/// defeat the point of a reusable fabric catalog). Pure join table, same
/// shape as `UserRole`/`ProjectMember`: hard-delete, `addedAt`/`addedBy`
/// instead of a full audit block, composite primary key.
model ProductFabric {
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  fabricId  String   @map("fabric_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at")
  addedBy   String?  @map("added_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fabric  Fabric  @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@id([productId, fabricId])
  @@index([tenantId])
  @@index([fabricId])
  @@map("product_fabrics")
}

/// A named, reusable set of an individual's body measurements (e.g.
/// "John's Suit Measurements — March 2026"), independently manageable via
/// its own controller (repository class is literally named
/// `MeasurementRepository` per this milestone's brief — see this
/// section's header comment — but targets this model as its aggregate
/// root). `userId` is optional and nullable-on-delete — not explicitly
/// asked for by this milestone's "Relationships" list, but a measurement
/// profile needs SOME owner to be a meaningful, listable resource; kept
/// minimal (no Client-level link, no order/cart link — those don't exist
/// yet and aren't this milestone's scope).
model MeasurementProfile {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  name     String
  notes    String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  measurements Measurement[]

  @@index([tenantId])
  @@index([userId])
  @@map("measurement_profiles")
}

enum MeasurementUnit {
  IN
  CM
}

/// A single named measurement within a profile (e.g. "Chest" = 40.5 in).
/// Line-item shaped like `ProductVariant`: `createdAt`/`updatedAt` only,
/// no soft-delete/version, Cascade-deleted with its parent profile, no
/// standalone controller — always read/written as part of its
/// MeasurementProfile. The unique constraint below is this milestone's
/// own explicit business rule ("Measurement names are unique within a
/// profile") enforced at the database level, not just in the service.
model Measurement {
  id                   String          @id @default(uuid(7)) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  measurementProfileId String          @map("measurement_profile_id") @db.Uuid
  name                 String
  value                Decimal         @db.Decimal(8, 2)
  unit                 MeasurementUnit
  notes                String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  measurementProfile MeasurementProfile @relation(fields: [measurementProfileId], references: [id], onDelete: Cascade)

  // No soft-delete on this table — a real (non-partial) unique index is
  // correct as generated, same reasoning as product_variants' own sku
  // uniqueness in Milestone 5.
  @@unique([measurementProfileId, name])
  @@index([tenantId])
  @@map("measurements")
}

/// A named category of style choice for a product's customization (e.g.
/// "Collar Style", "Cuff Style") — created only as nested data under its
/// parent ProductCustomization (no standalone controller — see this
/// section's header comment), so it gets the same light, line-item
/// treatment as StyleOptionGroup's own children below get from it:
/// `createdAt`/`updatedAt` only, no soft-delete/version, Cascade-deleted
/// with its parent.
model StyleOptionGroup {
  id                     String  @id @default(uuid(7)) @db.Uuid
  tenantId               String  @map("tenant_id") @db.Uuid
  productCustomizationId String  @map("product_customization_id") @db.Uuid
  name                   String
  description            String?
  isRequired             Boolean @default(true) @map("is_required")
  sortOrder              Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productCustomization ProductCustomization @relation(fields: [productCustomizationId], references: [id], onDelete: Cascade)
  styleOptions         StyleOption[]

  @@index([tenantId])
  @@index([productCustomizationId])
  @@map("style_option_groups")
}

enum StyleOptionStatus {
  ACTIVE
  ARCHIVED
}

/// An individual selectable choice within a StyleOptionGroup (e.g.
/// "Spread Collar"). Unlike its parent group, this gets its own full
/// standalone CRUD surface (this milestone's brief lists "Style Options"
/// as its own controller + `StyleOptionRepository`) — new choices can be
/// added/retired within a group's fixed structure over time. Full
/// audit/soft-delete treatment, matching every other independently
/// controller-backed entity in this schema. `priceAdjustment` is the same
/// plain stored `Decimal` delta convention as `Fabric.priceAdjustment`.
model StyleOption {
  id                 String            @id @default(uuid(7)) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  styleOptionGroupId String            @map("style_option_group_id") @db.Uuid
  name               String
  description        String?
  priceAdjustment    Decimal           @default(0) @map("price_adjustment") @db.Decimal(12, 2)
  status             StyleOptionStatus @default(ACTIVE)
  sortOrder          Int               @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant             Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  styleOptionGroup   StyleOptionGroup             @relation(fields: [styleOptionGroupId], references: [id], onDelete: Cascade)
  incompatibleAsA    StyleOptionIncompatibility[] @relation("StyleOptionA")
  incompatibleAsB    StyleOptionIncompatibility[] @relation("StyleOptionB")
  pricingAdjustments PricingAdjustment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([styleOptionGroupId])
  @@map("style_options")
}

/// Admin-configured "these two style options cannot be combined" rule —
/// not named in this milestone's "Core entities" list, but structurally
/// required to make "Incompatible style combinations are rejected"
/// (this milestone's own explicit business rule) expressible at all.
/// Pure join table (hard-delete, `addedAt`/`addedBy`, like
/// `ProductFabric` above). Stored one-directionally (styleOptionAId <
/// styleOptionBId, enforced by the service, not the schema); a
/// compatibility check queries both directions.
model StyleOptionIncompatibility {
  tenantId       String   @map("tenant_id") @db.Uuid
  styleOptionAId String   @map("style_option_a_id") @db.Uuid
  styleOptionBId String   @map("style_option_b_id") @db.Uuid
  reason         String?
  addedAt        DateTime @default(now()) @map("added_at")
  addedBy        String?  @map("added_by") @db.Uuid

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  styleOptionA StyleOption @relation("StyleOptionA", fields: [styleOptionAId], references: [id], onDelete: Cascade)
  styleOptionB StyleOption @relation("StyleOptionB", fields: [styleOptionBId], references: [id], onDelete: Cascade)

  @@id([styleOptionAId, styleOptionBId])
  @@index([tenantId])
  @@index([styleOptionBId])
  @@map("style_option_incompatibilities")
}

/// The bespoke configuration for a single Product — 1:1 (`productId` is
/// unique), aggregating everything a customer could configure: which
/// StyleOptionGroups apply, what PricingAdjustments and MonogramOptions
/// exist. This is admin-authored CONFIGURATION, not a customer's actual
/// order/cart selection — Orders/Cart are explicitly out of this
/// milestone's scope, so there is nothing here that captures what any
/// specific customer chose. No delete endpoint (this milestone's own
/// "Controllers" section lists Create/Update/Get/List only for Product
/// Customization) — removing bespoke configuration from a product isn't
/// supported this milestone.
model ProductCustomization {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  productId   String  @unique @map("product_id") @db.Uuid
  name        String?
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  styleOptionGroups  StyleOptionGroup[]
  pricingAdjustments PricingAdjustment[]
  monogramOptions    MonogramOption[]

  // Milestone 8 (Order Management & Checkout)
  orderItems OrderItem[]

  // NOTE (Milestone 6): `productId` is `@unique` above (true 1:1 relation,
  // required by Prisma's relation validator) — replace with a PARTIAL
  // unique index WHERE deleted_at IS NULL in the hand-written migration,
  // same landmine as every soft-deletable unique key before it. Tenant
  // safety doesn't need `tenantId` in the constraint: a Product already
  // belongs to exactly one tenant, so uniqueness on `productId` alone
  // cannot cross a tenant boundary.
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("product_customizations")
}

enum PricingAdjustmentType {
  FLAT
  PERCENTAGE
}

/// A pricing rule attached to a ProductCustomization, optionally
/// triggered by choosing a specific StyleOption (`styleOptionId` is
/// nullable — a flat customization surcharge with no specific trigger is
/// also valid, e.g. "Bespoke tailoring fee"). Line-item shaped like
/// `ProductVariant`/`StyleOptionGroup` above: no standalone controller
/// (only nested under ProductCustomization's own create), no soft-delete.
/// `amount` may be negative for `FLAT` (a discount); `PERCENTAGE` is
/// bounded via a CHECK constraint in the migration (this milestone's own
/// "Pricing adjustments are valid" business rule).
model PricingAdjustment {
  id                     String                @id @default(uuid(7)) @db.Uuid
  tenantId               String                @map("tenant_id") @db.Uuid
  productCustomizationId String                @map("product_customization_id") @db.Uuid
  styleOptionId          String?               @map("style_option_id") @db.Uuid
  label                  String
  adjustmentType         PricingAdjustmentType @default(FLAT) @map("adjustment_type")
  amount                 Decimal               @db.Decimal(12, 2)
  isActive               Boolean               @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productCustomization ProductCustomization @relation(fields: [productCustomizationId], references: [id], onDelete: Cascade)
  styleOption          StyleOption?         @relation(fields: [styleOptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productCustomizationId])
  @@index([styleOptionId])
  @@map("pricing_adjustments")
}

/// The monogramming configuration offered on a product's customization
/// (e.g. "Chest Monogram" — up to 3 characters). "Monogram rules are
/// enforced" (this milestone's own business rule) means this record's
/// OWN fields are validated as sane at create/update time
/// (`maxCharacters > 0`, enforced via CHECK constraint) — there is no
/// customer-entered monogram TEXT to validate against these rules yet,
/// since capturing an actual customer selection belongs to the Cart/
/// Orders flow this milestone explicitly excludes. Line-item shaped like
/// PricingAdjustment above (no standalone controller, no soft-delete).
model MonogramOption {
  id                     String  @id @default(uuid(7)) @db.Uuid
  tenantId               String  @map("tenant_id") @db.Uuid
  productCustomizationId String  @map("product_customization_id") @db.Uuid
  label                  String
  maxCharacters          Int     @default(3) @map("max_characters")
  allowedCharacters      String? @map("allowed_characters")
  priceAdjustment        Decimal @default(0) @map("price_adjustment") @db.Decimal(12, 2)
  isActive               Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productCustomization ProductCustomization @relation(fields: [productCustomizationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productCustomizationId])
  @@map("monogram_options")
}

// =============================================================================
// INVENTORY & STOCK MANAGEMENT (Milestone 7)
// =============================================================================
// Same "no domain guidance exists" situation as Milestones 5/6: a fresh
// repo-wide search (not just docs/product/) found zero inventory/
// warehouse/supplier content — both `catalog/README.md` and
// `bespoke/README.md` explicitly disclaim inventory as out of their own
// scope, but neither describes what it should look like. This section is
// a deliberately generic inventory-ledger design, not modeled on any
// specific WMS/ERP's real schema.
//
// `InventoryItem`/`SupplierProduct` both track stock/supply for EITHER a
// `ProductVariant` OR a `Fabric`, never both — mirrors the existing
// `Quotation.leadId`/`clientId` XOR precedent
// (`20260717091000_check_constraints`'s own "Cross-column" section)
// exactly, extended here to a variant-vs-fabric choice instead of a
// lead-vs-client one. Enforced via a hand-written CHECK constraint in
// the migration (Prisma's schema DSL cannot express cross-column
// constraints), not just application-layer validation.

enum WarehouseStatus {
  ACTIVE
  ARCHIVED
}

/// A physical or logical stock location. Flat (no hierarchy/zones/bins —
/// not asked for by this milestone's brief, and out of scope for a first
/// pass at warehouse-aware inventory).
model Warehouse {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  name         String
  slug         String
  addressLine1 String?         @map("address_line1")
  city         String?
  region       String?
  postalCode   String?         @map("postal_code")
  country      String?
  status       WarehouseStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]

  // NOTE (Milestone 7, same landmine as every soft-deletable tenant-scoped
  // unique key before it): replace with a PARTIAL unique index WHERE
  // deleted_at IS NULL in the hand-written migration.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("warehouses")
}

/// The stock record for one (warehouse, variant-or-fabric) pair.
/// `onHand`/`reserved` are persisted running counters, mutated only
/// through `InventoryService`'s transactional operations (never directly
/// patched) — every mutation also writes an `InventoryTransaction` row in
/// the same database transaction, so the ledger and the counters can
/// never drift apart. `available` (`onHand - reserved`, this milestone's
/// own "Available = OnHand − Reserved" business rule) is deliberately
/// NOT a stored column — it's computed at read time (mapper), the same
/// "data, not a derived-value sync bug waiting to happen" discipline
/// `ProductVariant.price` already established for a different reason.
/// Decimal(12,3), not (12,2) like money — fabric stock is realistically
/// measured in fractional units (yards/meters), unlike a variant's whole-
/// unit count, and one shared column serves both without a second schema
/// for one case.
model InventoryItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  fabricId         String?  @map("fabric_id") @db.Uuid
  onHand           Decimal  @default(0) @map("on_hand") @db.Decimal(12, 3)
  reserved         Decimal  @default(0) @map("reserved") @db.Decimal(12, 3)
  reorderPoint     Decimal? @map("reorder_point") @db.Decimal(12, 3)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouse      Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productVariant ProductVariant?        @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  fabric         Fabric?                @relation(fields: [fabricId], references: [id], onDelete: Restrict)
  transactions   InventoryTransaction[]
  reservations   InventoryReservation[]

  // NOTE (Milestone 7): two PARTIAL unique indexes, hand-written in the
  // migration — `(warehouse_id, product_variant_id) WHERE
  // product_variant_id IS NOT NULL AND deleted_at IS NULL` and
  // `(warehouse_id, fabric_id) WHERE fabric_id IS NOT NULL AND deleted_at
  // IS NULL` — Prisma's schema DSL can express neither a filtered index
  // nor one scoped to "the non-null side of an XOR pair", so both are
  // absent from this block entirely and added by hand.
  //
  // NOTE (Milestone 12 — Performance Engineering): a third hand-written
  // PARTIAL index — `(tenant_id, reorder_point) WHERE reorder_point IS
  // NOT NULL AND deleted_at IS NULL` — backs
  // InventoryRepository.findLowStockItems()'s own `on_hand <=
  // reorder_point` query (see that method's comment); same Prisma-DSL
  // limitation as the two above.
  @@index([tenantId])
  @@index([warehouseId])
  @@index([productVariantId])
  @@index([fabricId])
  // Phase 10, Module 1 (Performance) — InventoryItemListQueryDto filters
  // by warehouseId/productVariantId/fabricId independently but always
  // tenant-scoped; these composites replace a bitmap-AND of two
  // single-column indexes with one composite scan.
  @@index([tenantId, warehouseId])
  @@index([tenantId, productVariantId])
  @@index([tenantId, fabricId])
  @@map("inventory_items")
}

enum InventoryTransactionType {
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  CONSUMPTION
}

/// Append-only stock-movement ledger — "Transactions are append-only"/
/// "Stock changes always create transaction records" (this milestone's
/// own business rules) enforced structurally: `createdAt` only, no
/// `updatedAt`/soft-delete/version — nothing about a row here is ever
/// mutable after creation, unlike every other entity in this schema.
/// `onHandDelta`/`reservedDelta` are signed (positive or negative) —
/// `RECEIPT`/`ADJUSTMENT` only ever touch `onHandDelta`,
/// `RESERVATION`/`RELEASE` only ever touch `reservedDelta`,
/// `CONSUMPTION` touches both simultaneously (reserved stock leaving
/// inventory for good). `onHandAfter`/`reservedAfter` are snapshots of
/// `InventoryItem`'s counters immediately after this transaction applied
/// — convenient point-in-time audit reading without replaying the whole
/// history from zero.
model InventoryTransaction {
  id              String                   @id @default(uuid(7)) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  inventoryItemId String                   @map("inventory_item_id") @db.Uuid
  type            InventoryTransactionType
  onHandDelta     Decimal                  @default(0) @map("on_hand_delta") @db.Decimal(12, 3)
  reservedDelta   Decimal                  @default(0) @map("reserved_delta") @db.Decimal(12, 3)
  onHandAfter     Decimal                  @map("on_hand_after") @db.Decimal(12, 3)
  reservedAfter   Decimal                  @map("reserved_after") @db.Decimal(12, 3)
  reason          String?
  referenceId     String?                  @map("reference_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@map("inventory_transactions")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

/// A hold against available stock. Lifecycle is captured entirely by
/// `status` (`ACTIVE → RELEASED` or `ACTIVE → CONSUMED`, both terminal)
/// — no soft-delete: "deleting" a decided reservation doesn't mean
/// anything a status transition doesn't already express, and the full
/// history stays queryable by status rather than disappearing behind
/// `deletedAt`. `reference` is a free-text optional external reference
/// (there is no Order/Cart entity yet to link to — explicitly out of
/// this milestone's scope, see "Do NOT Implement").
model InventoryReservation {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  inventoryItemId String            @map("inventory_item_id") @db.Uuid
  quantity        Decimal           @db.Decimal(12, 3)
  status          ReservationStatus @default(ACTIVE)
  reference       String?
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  // Milestone 8 (Order Management & Checkout) — the forward reference
  // this model's own doc comment above named ("no Order/Cart entity yet
  // to link to"). 1:1 from this side — `OrderItem.inventoryReservationId`
  // is `@unique`, so at most one OrderItem claims a given reservation.
  orderItem OrderItem?

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([tenantId, status])
  @@map("inventory_reservations")
}

enum SupplierStatus {
  ACTIVE
  ARCHIVED
}

/// A vendor the tenant sources fabrics/finished-good variants from. Full
/// CRUD via its own controller (this milestone's brief lists "Supplier:
/// CRUD" explicitly).
model Supplier {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  name         String
  slug         String
  contactName  String?        @map("contact_name")
  contactEmail String?        @map("contact_email")
  contactPhone String?        @map("contact_phone")
  status       SupplierStatus @default(ACTIVE)
  notes        String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplierProducts SupplierProduct[]

  // NOTE (Milestone 7): partial unique WHERE deleted_at IS NULL — see
  // Warehouse note above.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("suppliers")
}

/// What one Supplier supplies — a ProductVariant or a Fabric (XOR, same
/// pattern as InventoryItem above), plus supplier-specific cost/lead
/// time. This milestone's brief lists no `SupplierProductRepository`/
/// controller (only `WarehouseRepository`/`InventoryRepository`/
/// `SupplierRepository` — 3 repositories for 6 entities), so this is
/// created only as nested data under `Supplier`'s own create/update —
/// same light, line-item shape as `ProductVariant`/`ProductImage`
/// (`createdAt`/`updatedAt` only, no soft-delete/version, Cascade-deleted
/// with its parent Supplier).
model SupplierProduct {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  productVariantId String?  @map("product_variant_id") @db.Uuid
  fabricId         String?  @map("fabric_id") @db.Uuid
  supplierSku      String?  @map("supplier_sku")
  cost             Decimal? @db.Decimal(12, 2)
  leadTimeDays     Int?     @map("lead_time_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  fabric         Fabric?         @relation(fields: [fabricId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([supplierId])
  @@index([productVariantId])
  @@index([fabricId])
  @@map("supplier_products")
}

// =============================================================================
// ORDER MANAGEMENT & CHECKOUT (Milestone 8)
// =============================================================================
// Same "no domain guidance exists" situation as Milestones 5-7 — checked
// fresh; the only prior art is this codebase's own forward-reference
// comments (Product, MeasurementProfile, ProductCustomization,
// MonogramOption, InventoryReservation) explicitly naming "the future
// Orders/Cart system" without describing its shape. This section is the
// orchestration layer those comments anticipated: it coordinates
// Catalog/Bespoke/Inventory rather than reimplementing any of their own
// logic — no pricing engine (line totals are computed once at order-
// creation time and stored, the same "data, not logic" discipline
// ProductVariant.price/PricingAdjustment.amount already established), no
// duplicate stock-tracking (every reservation is a real
// InventoryReservation, created through InventoryService).
//
// `Customer` is a genuinely new concept, distinct from the existing
// `Client` model — `Client` is the AGENCY's own B2B customer
// organization (who Antrique bills for web-agency services); `Customer`
// is an end-customer placing a bespoke/catalog order. The two are
// unrelated on purpose; nothing here references `Client`.

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

/// The person placing orders — distinct from `Client` (the agency's own
/// B2B customer org) and from `User` (portal/staff accounts, though a
/// Customer MAY optionally link to one). Full CRUD via its own
/// controller.
model Customer {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String?        @map("user_id") @db.Uuid
  email     String
  firstName String?        @map("first_name")
  lastName  String?        @map("last_name")
  phone     String?
  status    CustomerStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses CustomerAddress[]
  orders    Order[]

  // Milestone 9 — the reverse side of Lead.convertedCustomerId (a Lead
  // converts into at most one Customer; a Customer could in principle be
  // the conversion target of more than one Lead over time, hence a list
  // here even though the forward direction is single-valued) plus the
  // four new CRM entities this milestone scopes to `customerId`.
  convertedFromLeads Lead[]
  notes              CustomerNote[]
  activities         CustomerActivity[]
  followUpTasks      FollowUpTask[]
  tagAssignments     CustomerTagAssignment[]
  // Milestone 10 — "Invoices belong to Orders," this milestone's own
  // framing; an order-based Invoice references the paying Customer
  // directly too (not just through its Order), the same denormalized-
  // for-querying shape Order.customerId itself already uses.
  invoices           Invoice[]

  // NOTE (Milestone 8, same landmine as every soft-deletable tenant-scoped
  // unique key before it): replace with a PARTIAL unique index WHERE
  // deleted_at IS NULL in the hand-written migration. This is also
  // "Duplicate email handling" — this milestone's own explicit business
  // rule — enforced at the database level, translated to 409 by
  // CustomerService, same pattern every prior module's slug uniqueness
  // already established.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([userId])
  @@map("customers")
}

/// A shipping/billing address on file for a Customer. Line-item shaped
/// like `ProductVariant`/`SupplierProduct` (`createdAt`/`updatedAt` only,
/// no soft-delete/version) — no standalone controller (this milestone's
/// brief lists only `CustomerRepository`/`OrderRepository`, not a
/// `CustomerAddressRepository`), created/replaced only as nested data
/// under Customer's own create/update. "Default addresses" (this
/// milestone's own business responsibility) is `isDefaultShipping`/
/// `isDefaultBilling` booleans, service-managed (CustomerService unsets
/// any previous default before setting a new one, inside a transaction)
/// rather than a DB constraint — unlike inventory's counters, having two
/// defaults exist momentarily under a race is a minor UX issue, not a
/// financial-correctness one, so the lighter-weight approach is
/// proportionate.
model CustomerAddress {
  id                String  @id @default(uuid(7)) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  customerId        String  @map("customer_id") @db.Uuid
  label             String?
  line1             String
  line2             String?
  city              String
  region            String?
  postalCode        String? @map("postal_code")
  country           String
  phone             String?
  isDefaultShipping Boolean @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean @default(false) @map("is_default_billing")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Named relations — an address can be referenced by many orders as
  // EITHER their shipping OR billing address, two independent relations
  // to the same target model, so each needs its own back-relation field.
  ordersAsShipping Order[] @relation("OrderShippingAddress")
  ordersAsBilling  Order[] @relation("OrderBillingAddress")

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_addresses")
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

/// The order header. `subtotal`/`total` are plain stored sums, computed
/// once at creation from each `OrderItem`'s own stored `lineTotal` — no
/// live pricing engine, no recomputation on read (same discipline
/// `Quotation`/`Invoice`'s own stored amounts already draw). `status`
/// starts at `DRAFT`; every transition is recorded in
/// `OrderStatusHistory` — "Status changes must always create
/// OrderStatusHistory records. No status mutation without history" (this
/// milestone's own explicit rule), enforced by `OrderService` always
/// writing both in the same transaction, never one without the other.
/// Transition rules (this milestone's own workflow diagram, read as
/// realistic e-commerce semantics rather than literally — see
/// docs/implementation/decisions.md for why): DRAFT → PENDING →
/// CONFIRMED → PROCESSING → COMPLETED is strictly forward, one step at a
/// time; CANCELLED is reachable from any of DRAFT/PENDING/CONFIRMED/
/// PROCESSING (never from COMPLETED); COMPLETED and CANCELLED are both
/// terminal.
model Order {
  id                String      @id @default(uuid(7)) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  customerId        String      @map("customer_id") @db.Uuid
  status            OrderStatus @default(DRAFT)
  shippingAddressId String?     @map("shipping_address_id") @db.Uuid
  billingAddressId  String?     @map("billing_address_id") @db.Uuid
  subtotal          Decimal     @default(0) @db.Decimal(12, 2)
  total             Decimal     @default(0) @db.Decimal(12, 2)
  notes             String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress CustomerAddress?     @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  CustomerAddress?     @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  paymentRecords  PaymentRecord[]
  // Milestone 10 — "Create [Invoice] from Order," this milestone's own
  // entry point. A list, not a single nullable back-reference: nothing
  // in this milestone's own brief forbids re-invoicing an order (e.g.
  // after a void), so the schema doesn't artificially constrain it to
  // exactly one.
  invoices        Invoice[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([tenantId, createdAt])
  @@map("orders")
}

/// One line item on an order — a specific `ProductVariant`, optionally
/// customized via a `ProductCustomization`. Line-item shaped
/// (`createdAt`/`updatedAt` only, no soft-delete/version), no standalone
/// controller — created only as nested data under `POST /orders`, never
/// edited/removed individually (immutable once the order is placed,
/// matching `QuotationItem`/`InvoiceItem`'s own precedent). `unitPrice`
/// is a snapshot of `ProductVariant.price` at order time (never re-read
/// live); `pricingAdjustmentsTotal` is the sum of matching
/// `PricingAdjustment.amount` rows for whatever the customer selected,
/// computed once and stored; `lineTotal = quantity * unitPrice +
/// pricingAdjustmentsTotal`. `selectedOptions` is an open `Json?` bag
/// (style option ids chosen, monogram text, ...) — the same "escape
/// hatch instead of a new relational entity" pattern
/// `ProductVariant.attributes`/`Product.metadata` already established;
/// this milestone's brief names no dedicated "customer selection" entity
/// in its own "Core entities" list, so validated JSON is the
/// proportionate choice over inventing one.
/// `inventoryReservationId` links to the real `InventoryReservation`
/// `OrderService` created via `InventoryService.reserveStock()` for this
/// line — `@unique` (1:1: one reservation belongs to at most one order
/// item) — this is what order cancellation walks to release stock.
model OrderItem {
  id                      String  @id @default(uuid(7)) @db.Uuid
  tenantId                String  @map("tenant_id") @db.Uuid
  orderId                 String  @map("order_id") @db.Uuid
  productVariantId        String  @map("product_variant_id") @db.Uuid
  productCustomizationId  String? @map("product_customization_id") @db.Uuid
  inventoryReservationId  String? @unique @map("inventory_reservation_id") @db.Uuid
  quantity                Decimal @db.Decimal(12, 3)
  unitPrice               Decimal @map("unit_price") @db.Decimal(12, 2)
  pricingAdjustmentsTotal Decimal @default(0) @map("pricing_adjustments_total") @db.Decimal(12, 2)
  lineTotal               Decimal @map("line_total") @db.Decimal(12, 2)
  selectedOptions         Json?   @map("selected_options")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant       ProductVariant        @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  productCustomization ProductCustomization? @relation(fields: [productCustomizationId], references: [id], onDelete: Restrict)
  inventoryReservation InventoryReservation? @relation(fields: [inventoryReservationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderId])
  @@index([productVariantId])
  @@index([productCustomizationId])
  @@map("order_items")
}

/// Append-only status ledger — "Immutable status history"/"No status
/// mutation without history" (this milestone's own explicit business
/// rules) enforced structurally: `createdAt` only, no `updatedAt`/soft-
/// delete/version, same shape `InventoryTransaction` already established
/// for an identical "this table records events, it never edits them"
/// requirement. `previousStatus` is nullable — the very first row (DRAFT
/// at order creation) has no prior state to record.
model OrderStatusHistory {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  status         OrderStatus
  previousStatus OrderStatus? @map("previous_status")
  note           String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("order_status_history")
}

/// Placeholder only — this milestone's own brief is explicit
/// ("PaymentRecord (placeholder only)"). No service/controller/repository
/// exists for this model; it carries no status/gateway fields, no
/// behavior, purely a schema anchor for the payment-gateway-integration
/// milestone this one's own "Do NOT Implement" list explicitly defers.
model PaymentRecord {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  orderId  String  @map("order_id") @db.Uuid
  amount   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@map("payment_records")
}

// =============================================================================
// CRM & CUSTOMER OPERATIONS (Milestone 9)
// =============================================================================
// Architecture audit (before writing any code): a repo-wide search found
// `Lead`/`Client`/`ContactRequest` already fully modeled (Phase 1.1A, see
// the original "CRM" section above) with ZERO application-layer
// consumers — no LeadRepository/LeadService/LeadController existed
// before this milestone, the same "schema exists, this is its first real
// consumer" situation Milestone 3 found for Role/Permission. `ActivityLog`
// also already exists but is project-anchored (`projectId`), not
// customer-anchored — reusing it for a customer timeline would require
// bolting on an unrelated `customerId` to a table whose own doc comment
// scopes it to "the portal's Timeline (event feed) and the admin
// activity dashboard" for delivery work; every prior milestone's own
// append-only ledger is scoped to its own aggregate instead
// (`InventoryTransaction`, `OrderStatusHistory`) — `CustomerActivity`
// follows that same precedent rather than overloading `ActivityLog`. No
// `Inquiry`/`Note`/`FollowUp`/`Tag` entities existed anywhere. This
// section therefore reuses `Lead` wholesale (two new nullable columns
// only, both additive — see `Lead`'s own updated comment) and adds six
// genuinely new tables. See docs/implementation/decisions.md for the
// full reasoning on every non-obvious call below.

/// A lookup taxonomy for where a Lead originated (e.g. "Website",
/// "Referral", "Cold Outbound", "Trade Show") — this milestone's own
/// named core entity. Additive alongside `Lead.source` (the existing
/// free-text column, Phase 1.1A, also independently used by
/// `ContactRequest.source`): `Lead.source` is left untouched rather than
/// replaced, since migrating it to a required FK would be a breaking
/// change to already-seeded/production data for a column two OTHER
/// entities' worth of prior milestones already depend on. Leads created
/// through this milestone's own `LeadService.create()` may optionally
/// set `leadSourceId`; when they do, `source` is populated FROM the
/// resolved `LeadSource.name` (kept in sync, never independently
/// editable once a `leadSourceId` is set) so the existing NOT NULL
/// column and this milestone's own list "Source" filter both keep
/// working uniformly, whether a lead names a formal source or a free-
/// text legacy one.
model LeadSource {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  slug     String
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leads  Lead[]

  // Partial (soft-deletable) — same landmine every soft-deletable
  // tenant-scoped unique key in this schema already has; hand-written in
  // the migration.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("lead_sources")
}

/// A free-text note attached to a Customer — "Rich text supported" (this
/// milestone's own explicit requirement) means `body` stores sanitized
/// HTML/markdown as a plain string, the same "no dedicated rich-text
/// entity, just a validated string column" choice
/// `OrderItem.selectedOptions`/`Product.metadata` already established
/// for "don't invent a relational entity where a scalar column suffices."
/// "Notes never hard-delete" (this milestone's own explicit rule) is why
/// this model gets full soft-delete unlike the append-only entities
/// below — `CustomerNoteService.remove()` only ever sets `deletedAt`,
/// there is no hard-delete path anywhere in this module.
model CustomerNote {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  customerId   String  @map("customer_id") @db.Uuid
  authorUserId String? @map("author_user_id") @db.Uuid
  body         String  @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation("CustomerNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, createdAt])
  @@map("customer_notes")
}

// Exactly the three triggers this milestone's own "Automatic activity
// creation for" list names — lead creation, lead conversion, follow-up
// completion — no more. No `NOTE_ADDED`/`MANUAL`/etc.: this milestone's
// own "Activities" Controllers list is "Timeline, List" only, no create
// route, so no OTHER trigger has a way to fire in the first place; adding
// enum values with nothing that could ever produce them would be
// speculative, not requirement-driven.
enum CustomerActivityType {
  LEAD_CREATED
  LEAD_CONVERTED
  FOLLOW_UP_COMPLETED
}

/// The customer engagement timeline — "Timeline creation"/"Timeline
/// remains append-only" (this milestone's own explicit rules), the same
/// "this table records events, it never edits them" shape
/// `InventoryTransaction`/`OrderStatusHistory` already established:
/// `createdAt` only, no `updatedAt`/soft-delete/version.
/// `CustomerActivityService` is the only writer — every one of this
/// milestone's own "Automatic activity creation for" triggers
/// (lead creation, lead conversion, follow-up completion) calls it
/// directly from `LeadService`/`FollowUpService` (same-module, no event
/// bus). `customerId` is NULLABLE — "lead creation" fires before any
/// Customer exists (a lead hasn't converted yet), so that trigger writes
/// `customerId: null, relatedLeadId: <lead>`; "lead conversion" writes
/// BOTH (the newly linked Customer AND the originating Lead — a genuine
/// dual reference, not an XOR, unlike `FollowUpTask`'s own lead-vs-
/// customer choice); "follow-up completion" writes whichever of
/// `customerId`/`relatedLeadId` matches that `FollowUpTask`'s own target.
/// At least one of `customerId`/`relatedLeadId` is always set — enforced
/// by `CustomerActivityRepository.createInTx()`'s only two callers
/// (`LeadService`/`FollowUpService`; there is no public, client-facing
/// create endpoint for this table — see this milestone's own
/// "Controllers" list, "Timeline, List" only), not by a DB CHECK
/// constraint, since no externally-supplied row is ever written here to
/// validate.
model CustomerActivity {
  id            String               @id @default(uuid(7)) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  customerId    String?              @map("customer_id") @db.Uuid
  type          CustomerActivityType
  summary       String
  actorUserId   String?              @map("actor_user_id") @db.Uuid
  relatedLeadId String?              @map("related_lead_id") @db.Uuid
  metadata      Json?

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actor       User?     @relation("CustomerActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  relatedLead Lead?     @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, createdAt])
  @@index([relatedLeadId])
  @@map("customer_activities")
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// A scheduled callback/task — "Create, Complete, Reopen, Cancel,
/// Due-date validation" (this milestone's own explicit business
/// responsibilities). Deliberately NOT prefixed "Customer" like the
/// three entities above (this milestone's own naming choice, read
/// literally): a follow-up can target EITHER a `Lead` (pre-conversion —
/// "call this prospect back next week" is the more common real-world
/// case) OR a `Customer` (post-conversion), never both — the same
/// lead-vs-client XOR pattern `Quotation`/`InventoryItem` already
/// established in this schema, extended to a lead-vs-customer choice.
/// "Completed follow-ups cannot be edited" is enforced in
/// `FollowUpService.update()` (rejects once `status != PENDING`);
/// `complete()`/`cancel()`/`reopen()` are the only ways `status`
/// changes after creation — `reopen()` is the one path back to
/// `PENDING` from either terminal state, clearing `completedAt`.
model FollowUpTask {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  leadId      String?        @map("lead_id") @db.Uuid
  customerId  String?        @map("customer_id") @db.Uuid
  title       String
  description String?
  dueAt       DateTime       @map("due_at")
  status      FollowUpStatus @default(PENDING)
  assigneeId  String?        @map("assignee_id") @db.Uuid
  completedAt DateTime?      @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee User?     @relation("FollowUpTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // "Exactly one of lead/customer" — a hand-written cross-column CHECK
  // constraint in the migration, mirroring
  // `quotations_lead_xor_client_check` exactly.
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueAt])
  @@index([leadId])
  @@index([customerId])
  @@index([assigneeId])
  @@map("follow_up_tasks")
}

/// A tenant-defined tag vocabulary for Customers (e.g. "VIP", "Wholesale",
/// "At Risk") — this milestone's own named core entity, supporting the
/// "Tags" list filter.
model CustomerTag {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  slug     String
  color    String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments CustomerTagAssignment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("customer_tags")
}

/// Customer ↔ CustomerTag join — pure assignment, no state of its own
/// beyond "does this pairing exist," the same "line-item shaped, hard-
/// delete on unassign" treatment `ProductFabric` (Milestone 6) already
/// established for an identical many-to-many join: no soft-delete here,
/// `CustomerTagService.untag()` issues a real `DELETE`.
model CustomerTagAssignment {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  customerId    String @map("customer_id") @db.Uuid
  customerTagId String @map("customer_tag_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerTag CustomerTag @relation(fields: [customerTagId], references: [id], onDelete: Cascade)

  // Plain (not partial) — this join is never soft-deleted, so no
  // deleted_at predicate is needed the way Customer/LeadSource/
  // CustomerTag's own soft-deletable unique keys require.
  @@unique([tenantId, customerId, customerTagId])
  @@index([tenantId])
  @@index([customerId])
  @@index([customerTagId])
  @@map("customer_tag_assignments")
}

// =============================================================================
// PAYMENTS & BILLING FOUNDATION (Milestone 10)
// =============================================================================
// Architecture audit (before writing any code): a repo-wide search found
// `Invoice`/`InvoiceItem`/`Payment`/`Quotation`/`QuotationItem` already
// fully modeled (Phase 1.1A/1.1B) — including, notably, the
// `invoices_amount_paid_check` CHECK constraint ("amount_paid >= 0 AND
// amount_paid <= total_amount", `20260717091000_check_constraints`)
// ALREADY enforcing this milestone's own "Paid amount never exceeds
// invoice total" rule at the database level, and `payments` already
// having `UPDATE`/`DELETE` revoked at the database-privilege level
// (`20260717091500_row_level_security`) — with ZERO application-layer
// consumers for any of them (no InvoiceRepository/PaymentRepository/
// InvoiceService/PaymentService/InvoiceController/PaymentController
// existed before this milestone), the same "schema exists, first real
// consumer" situation Milestones 3 and 9 already found. No
// `TaxRate`/`PaymentMethod`/`PaymentAllocation` entities existed
// anywhere. `Invoice`/`Payment` are reused wholesale (see each model's
// own updated comment above for the additive-only changes); this
// section adds three genuinely new tables. Full reasoning for every
// non-obvious call: docs/implementation/decisions.md.

/// A tenant-defined tax rate (e.g. "GST 18%", "VAT 20%", "No Tax") —
/// this milestone's own named core entity, supporting "Support multiple
/// tax rates." Full CRUD via its own controller (unlike `PaymentMethod`
/// below) — this milestone's own "Controllers" list names "Tax — CRUD"
/// explicitly.
model TaxRate {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  rate     Decimal @db.Decimal(5, 2)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("tax_rates")
}

/// A lookup taxonomy for how a Payment was received (e.g. "Cash", "Bank
/// Transfer", "Cheque") — this milestone's own named core entity.
/// Deliberately NO controller/service/repository of its own, unlike
/// `TaxRate` above — `Payment.method` (the required free-text column)
/// already satisfies every filter/display need on its own, so a
/// `PaymentMethod` row's absence never leaves anything unreachable the
/// way a missing `CustomerTag` write path would have in Milestone 9;
/// rows exist only via seed data this milestone. Same "no controller
/// where nothing is left unsatisfiable without one" reasoning
/// `LeadSource` (Milestone 9) already established. See
/// docs/implementation/decisions.md.
model PaymentMethod {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  slug     String
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("payment_methods")
}

/// How much of a given `Payment` was applied to a given `Invoice` —
/// "Allocate payment," this milestone's own named core entity and
/// explicit business responsibility, split out from `Payment` itself
/// specifically so a payment CAN be recorded before it's tied to any
/// invoice, then allocated (possibly across more than one invoice, or
/// partially) afterward. Append-only, same shape `CustomerActivity`/
/// `OrderStatusHistory`/`InventoryTransaction` already established
/// (`createdAt` only, no `updatedAt`/soft-delete/version) — "Payment
/// allocations cannot exceed payment amount" is a creation-time
/// invariant only, this milestone's own brief asks for no "unallocate"
/// action. Given the same "financial ledger integrity" reasoning that
/// already earned `Payment` its own database-privilege-level
/// `UPDATE`/`DELETE` revoke (Phase 1.1A/1.1B), this table gets the
/// identical treatment in the migration — see
/// docs/implementation/decisions.md.
model PaymentAllocation {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  amount    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([tenantId, createdAt])
  @@map("payment_allocations")
}

// =============================================================================
// ADMIN PLATFORM, ANALYTICS & NOTIFICATIONS (Milestone 11)
// =============================================================================
// Architecture audit (before writing any code): a repo-wide search found
// `Notification`/`ActivityLog`/`AuditLog`/`Setting` already fully
// modeled (Phase 1.1B) — `Notification`/`AuditLog` are reused wholesale
// (see each model's own updated comment above); `ActivityLog` is
// deliberately NOT reused for `SystemEvent` below, for the same "reuse
// only when the aggregate scope genuinely matches" reasoning Milestone 9
// already applied when it declined to reuse `ActivityLog` for
// `CustomerActivity` — `ActivityLog` is project-scoped human business
// timeline, `SystemEvent` is a generic tenant-scoped operational/
// observability ledger, a different aggregate entirely. No
// `NotificationTemplate`/`SystemEvent`/`DashboardWidget`/`ScheduledReport`
// entities existed anywhere. Full reasoning for every non-obvious call:
// docs/implementation/decisions.md.

/// A reusable message template keyed by notification `type` + `channel`
/// (e.g. "invoice.paid"/EMAIL) — this milestone's own named core entity.
/// Deliberately NO controller/service/repository of its own beyond a
/// narrow resolve-by-key lookup — `Notification.title`/`body` are
/// already plain, always-populated columns (same "always populated,
/// optionally backed by a formal lookup row" pattern `Lead.source`/
/// `LeadSource` established in Milestone 9): `NotificationService.create()`
/// accepts an explicit `title`/`body`, OR resolves them from a
/// `NotificationTemplate` when a `templateKey` is given instead. Nothing
/// is left unreachable without a `NotificationTemplate` write path — rows
/// exist only via seed data this milestone.
model NotificationTemplate {
  id       String              @id @default(uuid(7)) @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  key      String
  channel  NotificationChannel
  subject  String
  body     String              @db.Text
  isActive Boolean             @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key, channel])
  @@index([tenantId])
  @@map("notification_templates")
}

enum SystemEventSeverity {
  INFO
  WARNING
  ERROR
}

/// A generic, tenant-scoped operational/observability ledger — this
/// milestone's own named core entity, distinct from `AuditLog`
/// (compliance/security, actor-centric) and `ActivityLog` (project-
/// scoped human business timeline). `type` is free-form (same
/// "new event kinds shouldn't need a migration" reasoning
/// `Notification.type` already established), `source` names the
/// module/subsystem that raised it (e.g. "inventory", "billing",
/// "notifications"). Append-only — "this table records events, it never
/// edits them," the same shape `InventoryTransaction`/`OrderStatusHistory`/
/// `CustomerActivity` already established (`createdAt` only, no
/// `updatedAt`/soft-delete/version) — enforced at the database-privilege
/// level too (`UPDATE`/`DELETE` revoked), the same treatment `AuditLog`/
/// `payments`/`payment_allocations` already have.
model SystemEvent {
  id                  String              @id @default(uuid(7)) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  type                String
  severity            SystemEventSeverity @default(INFO)
  source              String
  summary             String
  relatedResourceType String?             @map("related_resource_type")
  relatedResourceId   String?             @map("related_resource_id") @db.Uuid
  metadata            Json?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, severity])
  @@index([relatedResourceType, relatedResourceId])
  @@map("system_events")
}

enum DashboardWidgetType {
  KPI
  CHART
  LIST
}

/// An admin-configurable dashboard tile definition — this milestone's
/// own named core entity. Deliberately NO controller of its own — this
/// milestone's own "Dashboard" Controllers list is "Overview, KPI
/// endpoints" only, no widget-management route. Consumed internally:
/// `DashboardService.overview()` reads a tenant's own active widgets to
/// decide what to include in the response — a real read consumer, not
/// dead schema, even without a write endpoint (seed data is the only
/// write path this milestone).
model DashboardWidget {
  id        String              @id @default(uuid(7)) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  key       String
  title     String
  type      DashboardWidgetType
  config    Json?
  sortOrder Int                 @default(0) @map("sort_order")
  isActive  Boolean             @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("dashboard_widgets")
}

enum ReportType {
  SALES_SUMMARY
  INVENTORY_SUMMARY
  CRM_SUMMARY
  BILLING_SUMMARY
}

/// A generated report SNAPSHOT — "Reports are immutable after
/// generation"/"Reports remain read-only" (this milestone's own explicit
/// rules): `parameters` records what was asked for (date range, etc.),
/// `result` is the computed output at generation time, stored, never
/// recomputed on read — the same "compute once, store the result"
/// discipline `OrderItem.lineTotal`/`Invoice.taxAmount` already
/// established. Despite the model name (matching this milestone's own
/// "ScheduledReport" core-entity naming literally), this is NOT a cron
/// schedule/recurrence configuration — "Scheduled cron execution" is
/// explicitly this milestone's own "Do NOT Implement" item; every
/// report row here is generated synchronously, on demand, by
/// `POST /reports`. Append-only — the same shape `SystemEvent`/
/// `CustomerActivity` already established (`createdAt` only, no
/// `updatedAt`/soft-delete/version) — there is no update path anywhere
/// in this module.
model ScheduledReport {
  id                String     @id @default(uuid(7)) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  type              ReportType
  parameters        Json
  result            Json
  generatedByUserId String?    @map("generated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  generatedByUser User?  @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, type])
  @@map("scheduled_reports")
}

// =============================================================================
// AI WORKSPACE (Phase 8)
// =============================================================================
// Step 1 (AI Architecture — provider abstraction) has no schema footprint:
// the strategy/factory pattern and the four provider adapters
// (Anthropic/OpenAI/Gemini/OpenRouter) are pure application code, see
// apps/api/src/ai/README.md. This section is Step 2 (Prompt Library) only.

enum PromptCategory {
  PROPOSAL_GENERATION
  REQUIREMENT_ANALYSIS
  WEBSITE_AUDIT
  SEO_RECOMMENDATIONS
  CLIENT_EMAIL
  MEETING_SUMMARY
  SCOPE_GENERATION
  PROJECT_ESTIMATION
  RISK_ANALYSIS
  /// Phase 8, Step 6 — added after Steps 1-2's original 9 categories
  /// (which matched Step 2's own example list exactly); Task Generation
  /// wasn't one of those 9 examples but is its own later spec step.
  TASK_GENERATION
  /// Phase 8, Step 7 — one shared category for all six Content Assistant
  /// output kinds (case study/service description/blog draft/FAQ/landing
  /// page/social post); which kind is a `ContentDraft.type` value, not a
  /// separate PromptCategory each — one template handles all six via a
  /// {{contentType}} variable, same "one template per feature" shape
  /// every other Phase 8 step uses.
  CONTENT_GENERATION
}

/// A reusable, versioned prompt template (Step 2). `template` holds
/// `{{variable}}` placeholders; `variables` names every placeholder the
/// template actually references — read at render time to validate the
/// caller supplied all of them, not enforced at the DB level (Postgres has
/// no way to cross-check a text column against a string array column).
/// `version` is the same optimistic-lock counter every other model in this
/// schema already uses (Client/Milestone/Task/...), NOT a version-history
/// chain — Quotation's own doc comment already established "version =
/// counter, not history" as this codebase's deliberate reading of
/// "versioned" elsewhere; this model follows the same convention rather
/// than inventing a second meaning for the word here.
model PromptTemplate {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  key         String
  category    PromptCategory
  name        String
  description String?
  template    String
  variables   String[]
  isActive    Boolean        @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Partial unique index (WHERE deleted_at IS NULL) added by hand in the
  // migration, same "soft-deletable + slug-like key" landmine every prior
  // migration since 20260717090500_partial_unique_indexes documents — no
  // @@unique here, Prisma's own DSL can't express the partial form.
  @@index([tenantId])
  @@index([tenantId, category])
  @@map("prompt_templates")
}

/// Phase 8, Step 7 — the one AI output kind this spec step explicitly
/// requires persisting ("Store drafts only. Never publish automatically.")
/// rather than the ephemeral "no DB write" shape Steps 3-5 and Step 6's
/// own `generate()` use. No publish/status field — this app has no
/// content-management/publish pipeline for a draft to graduate into (the
/// marketing site is hand-authored pages, not CMS-backed); a human copies
/// an approved draft into wherever it's actually needed. No project/client
/// FK — Content Assistant output (case studies, blog drafts, social posts)
/// isn't inherently scoped to one delivery project the way a Proposal or
/// Task Generator suggestion is.
enum ContentDraftType {
  CASE_STUDY
  SERVICE_DESCRIPTION
  BLOG_DRAFT
  FAQ
  LANDING_PAGE
  SOCIAL_POST
}

model ContentDraft {
  id       String           @id @default(uuid(7)) @db.Uuid
  tenantId String           @map("tenant_id") @db.Uuid
  type     ContentDraftType
  title    String
  body     String           @db.Text
  brief    String           @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("content_drafts")
}

// =============================================================================
// PHASE 9 — ENTERPRISE OPERATIONS SUITE, MODULE 1: FINANCE
// =============================================================================

enum VendorStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Phase 9, Module 1, Step 1 (Vendor Management) — who the agency pays for
/// goods/services (contractors, software subscriptions, office supplies),
/// distinct from `Supplier` (Milestone 7 — who the agency sources
/// fabrics/finished-good variants FROM, linked only to `SupplierProduct`
/// for inventory sourcing, no payment-terms/tax-ID concept). Same flat
/// CRUD shape `Supplier` already establishes (name/slug/contact fields/
/// status/notes + full audit columns) plus two fields this phase's brief
/// specifically calls for: `gstin` (Tax Configuration, Step 6, needs a
/// vendor-side GSTIN to reconcile input-tax-credit — captured here now so
/// Step 6 doesn't need a second migration on this table) and
/// `paymentTerms` (free-text, e.g. "Net 30" — no fixed enum; every agency
/// negotiates its own terms per vendor, not a closed list).
model Vendor {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  name         String
  slug         String
  contactName  String?      @map("contact_name")
  contactEmail String?      @map("contact_email")
  contactPhone String?      @map("contact_phone")
  gstin        String?
  paymentTerms String?      @map("payment_terms")
  status       VendorStatus @default(ACTIVE)
  notes        String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // NOTE: partial unique WHERE deleted_at IS NULL — see User note above.
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  // Phase 10, Module 1 (Performance) — backs VendorListQueryDto's default
  // `sortBy: 'createdAt'`, matching every sibling model's existing
  // status+createdAt composite pairing.
  @@index([tenantId, createdAt])
  @@map("vendors")
}
