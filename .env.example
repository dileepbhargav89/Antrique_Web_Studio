# Shared/cross-cutting defaults. App-specific variables live in:
#   apps/api/.env.example
#   apps/web/.env.local.example
NODE_ENV=development
LOG_LEVEL=info

# Phase 10, Module 11 (Docker/infra) — read by `docker compose` itself for
# ${...} interpolation (this file, at the repo root, is what `docker
# compose` auto-loads for that — a separate mechanism from apps/api/.env's
# `env_file:`, which sets variables INSIDE the container instead). Only
# used by docker-compose.prod.yml; the dev compose file
# (docker-compose.yml/docker-compose.override.yml) still hardcodes
# antrique/antrique, since a throwaway local Postgres has no real secret to
# protect. REQUIRED (no default) before running
# `docker compose -f docker-compose.prod.yml up` — see that file's own
# header comment for why.
POSTGRES_USER=antrique
POSTGRES_PASSWORD=replace-me-with-a-real-random-secret
POSTGRES_DB=antrique
